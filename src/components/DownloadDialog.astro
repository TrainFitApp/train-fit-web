---
import { SITE } from '../data/site';
---

<dialog id="download-dialog" class="download-dialog" aria-labelledby="download-title">
  <div class="download-dialog__content">
    <button class="download-dialog__close" type="button" aria-label="Cerrar" data-dialog-close>×</button>
    <p class="eyebrow">Disponible ahora</p>
    <h2 id="download-title">Elige tu tienda</h2>
    <p>Descarga TrainFit y reúne entrenamiento, nutrición y progreso en una sola app.</p>
    <div class="download-dialog__stores">
      <a href={SITE.appStore} target="_blank" rel="noreferrer" aria-label="Descargar TrainFit en App Store, abre en nueva pestaña">
        <img src="/images/store-apple.webp" width="198" height="58" alt="Descargar en App Store" />
      </a>
      <a href={SITE.playStore} target="_blank" rel="noreferrer" aria-label="Descargar TrainFit en Google Play, abre en nueva pestaña">
        <img src="/images/store-google.webp" width="200" height="58" alt="Disponible en Google Play" />
      </a>
    </div>
  </div>
</dialog>

<style>
  .download-dialog { width: min(calc(100% - 2rem), 34rem); padding: 0; border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); background: var(--color-elevated); color: var(--color-text); box-shadow: 0 2rem 6rem rgba(0,0,0,.55); }
  .download-dialog::backdrop { background: rgba(0,0,0,.82); }
  .download-dialog__content { position: relative; padding: clamp(2rem, 6vw, 3.25rem); }
  .download-dialog h2 { margin: 0; font-size: clamp(2rem, 6vw, 3.4rem); letter-spacing: -.04em; line-height: 1; }
  .download-dialog p:not(.eyebrow) { color: var(--color-text-soft); }
  .download-dialog__close { position: absolute; top: 1rem; right: 1rem; display: grid; width: 3rem; height: 3rem; place-items: center; border: 1px solid var(--color-border); border-radius: 50%; background: transparent; cursor: pointer; font-size: 1.6rem; line-height: 1; }
  .download-dialog__close:hover { background: var(--color-muted); }
  .download-dialog__stores { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .download-dialog__stores a { border-radius: .5rem; transition: transform 140ms ease; }
  .download-dialog__stores a:hover { transform: translateY(-2px); }
  .download-dialog__stores img { width: auto; height: 3.3rem; }
</style>
