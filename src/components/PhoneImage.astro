---
interface Props {
  name: string;
  alt: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  sizes?: string;
}
const { name, alt, loading = 'lazy', class: className, sizes = '(max-width: 768px) 70vw, 420px' } = Astro.props;
---
<picture class={className}>
  <source type="image/avif" srcset={`/images/${name}-360.avif 360w, /images/${name}-540.avif 540w, /images/${name}-720.avif 720w`} sizes={sizes} />
  <source type="image/webp" srcset={`/images/${name}-360.webp 360w, /images/${name}-540.webp 540w, /images/${name}-720.webp 720w`} sizes={sizes} />
  <img src={`/images/${name}-540.webp`} width="540" height="960" loading={loading} decoding="async" alt={alt} />
</picture>
