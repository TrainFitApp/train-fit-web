---
import { NAV_ITEMS, SITE } from '../data/site';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href="/" aria-label="TrainFit, inicio">
      <img src="/brand/logo-mark.png" width="36" height="36" alt="" />
      <span>TrainFit</span>
    </a>
    <button class="menu-button" type="button" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-navigation" data-menu-button>
      <span></span><span></span>
    </button>
    <nav id="main-navigation" class="site-nav" aria-label="Navegación principal" data-menu>
      <div class="site-nav__links">
        {NAV_ITEMS.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
      <a
        class="button button--primary site-nav__cta"
        href="/descargar/"
        data-download-trigger
        data-app-store={SITE.appStore}
        data-play-store={SITE.playStore}
      >Descargar</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    height: var(--header-h);
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(15,15,15,.97);
  }
  .site-header__inner { display: flex; height: 100%; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: .65rem; font-size: 1.08rem; font-weight: 710; letter-spacing: -.025em; }
  .brand img { width: 2rem; height: 2rem; object-fit: contain; }
  .site-nav { display: flex; align-items: center; gap: 2.1rem; }
  .site-nav__links { display: flex; align-items: center; gap: 1.6rem; }
  .site-nav__links a { position: relative; color: var(--color-text-soft); font-size: .88rem; font-weight: 560; transition: color 140ms ease; }
  .site-nav__links a:hover,
  .site-nav__links a[aria-current='page'] { color: var(--color-text); }
  .site-nav__links a[aria-current='page']::after { position: absolute; right: 0; bottom: -.45rem; left: 0; height: 1px; background: var(--color-accent); content: ''; }
  .site-nav__cta { min-height: 2.65rem; padding: .65rem .95rem; }
  .menu-button { display: none; width: 3rem; height: 3rem; border: 0; background: transparent; cursor: pointer; }
  .menu-button span { display: block; width: 1.25rem; height: 1px; margin: .38rem auto; background: currentColor; }
  @media (max-width: 52rem) {
    .menu-button { display: block; }
    .site-nav { position: absolute; top: calc(100% + 1px); right: 0; left: 0; display: none; align-items: stretch; padding: 1.5rem var(--gutter) 2rem; border-bottom: 1px solid var(--color-border); background: var(--color-bg); }
    .site-nav[data-open] { display: grid; gap: 1.5rem; }
    .site-nav__links { display: grid; gap: .25rem; }
    .site-nav__links a { display: flex; min-height: 3rem; align-items: center; border-bottom: 1px solid var(--color-border); font-size: 1.08rem; }
    .site-nav__links a[aria-current='page']::after { display: none; }
    .site-nav__cta { width: 100%; }
  }
</style>
