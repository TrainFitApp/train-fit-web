---
interface Props { eyebrow: string; title: string; text: string; }
const { eyebrow, title, text } = Astro.props;
---
<header class="page-intro">
  <div class="container page-intro__grid">
    <p class="page-intro__section">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-intro__summary">{text}</p>
  </div>
</header>

<style>
  .page-intro { padding-block: clamp(6rem, 13vw, 11rem) clamp(4rem, 8vw, 7rem); border-bottom: 1px solid var(--color-border); }
  .page-intro__grid { display: grid; gap: 2rem; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .page-intro__section { grid-column: 1 / 3; margin: .55rem 0 0; color: var(--color-accent); font-size: .9rem; font-weight: 700; }
  .page-intro h1 { grid-column: 3 / 12; max-width: 11ch; margin: 0; font-size: clamp(4rem, 9vw, 6rem); font-weight: 620; letter-spacing: -.04em; line-height: .88; }
  .page-intro__summary { grid-column: 7 / 12; max-width: 36rem; margin: 2rem 0 0; color: var(--color-text-soft); font-size: 1.15rem; }
  @media (max-width: 48rem) {
    .page-intro { padding-block: 4.5rem 3.5rem; }
    .page-intro__grid { grid-template-columns: minmax(0, 1fr); }
    .page-intro__section, .page-intro h1, .page-intro__summary { grid-column: 1 / -1; }
    .page-intro h1 { min-width: 0; overflow-wrap: anywhere; font-size: clamp(3rem, 14.3vw, 4.1rem); }
    .page-intro__summary { margin-top: .5rem; font-size: 1rem; }
  }
</style>
