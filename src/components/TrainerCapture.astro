---
// Captura real de TrainFit Trainers, siempre en vista de ordenador (ver
// scripts/optimize-trainer-captures.mjs): «wide» es la ventana completa y
// «main» solo el área de contenido, sin la barra lateral. Hasta 48rem se sirve
// un recorte de esa misma vista, centrado en el componente que se explica,
// para que se lea en un teléfono.
interface Props {
  name: string;
  alt: string;
  frame?: 'wide' | 'main';
  loading?: 'eager' | 'lazy';
  sizes?: string;
  class?: string;
}
const { name, alt, frame = 'main', loading = 'lazy', sizes = '(max-width: 80rem) 100vw, 73.75rem', class: className } = Astro.props;
const width = frame === 'wide' ? 1280 : 1012;
const base = `/images/trainers/${name}`;
const mobile = '(max-width: 48rem)';
---
<picture class:list={['trainer-capture', className]}>
  <source media={mobile} type="image/avif" width="560" height="600" sizes="calc(100vw - 2.5rem)" srcset={`${base}-crop-420.avif 420w, ${base}-crop-840.avif 840w`} />
  <source media={mobile} type="image/webp" width="560" height="600" sizes="calc(100vw - 2.5rem)" srcset={`${base}-crop-420.webp 420w, ${base}-crop-840.webp 840w`} />
  <source type="image/avif" sizes={sizes} srcset={`${base}-${frame}-${width}.avif ${width}w, ${base}-${frame}-${width * 2}.avif ${width * 2}w`} />
  <source type="image/webp" sizes={sizes} srcset={`${base}-${frame}-${width}.webp ${width}w, ${base}-${frame}-${width * 2}.webp ${width * 2}w`} />
  <img src={`${base}-${frame}-${width}.webp`} width={width} height="800" alt={alt} loading={loading} decoding="async" fetchpriority={loading === 'eager' ? 'high' : undefined} />
</picture>

<style>
  .trainer-capture { display: block; overflow: hidden; border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); background: #000; }
  .trainer-capture img { display: block; width: 100%; height: auto; }
</style>
