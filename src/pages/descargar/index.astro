---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
---
<BaseLayout title="Descargar TrainFit" description="Descarga TrainFit para iOS o Android y conecta entrenamiento, nutrición y progreso." canonicalPath="/descargar/">
  <section class="download-page">
    <div class="container download-page__grid">
      <div class="download-page__copy reveal is-visible">
        <p class="eyebrow">Disponible en iOS y Android</p>
        <h1 class="display">Tu proceso empieza en la app.</h1>
        <p class="lede">Elige tu plataforma y descarga TrainFit desde su tienda oficial.</p>
        <div class="download-page__stores">
          <a href={SITE.appStore} target="_blank" rel="noreferrer"><img src="/images/store-apple.webp" width="198" height="58" alt="Descargar TrainFit en App Store" /></a>
          <a href={SITE.playStore} target="_blank" rel="noreferrer"><img src="/images/store-google.webp" width="200" height="58" alt="Descargar TrainFit en Google Play" /></a>
        </div>
      </div>
      <picture class="download-page__visual reveal is-visible">
        <source type="image/avif" srcset="/images/hero-480.avif 480w, /images/hero-760.avif 760w" sizes="(max-width: 768px) 90vw, 50vw" />
        <img src="/images/hero-760.webp" width="760" height="760" alt="Pantallas de la aplicación TrainFit" />
      </picture>
    </div>
  </section>
</BaseLayout>
<style>
  .download-page { min-height: calc(100svh - var(--header-h)); display: grid; align-items: center; padding-block: clamp(4rem, 9vw, 8rem); overflow: clip; }
  .download-page__grid { display: grid; align-items: center; gap: 3rem; grid-template-columns: .9fr 1.1fr; }
  .download-page__copy .lede { margin-top: 2rem; }
  .download-page__stores { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .download-page__stores a { border-radius: .5rem; transition: transform 140ms ease; }
  .download-page__stores a:hover { transform: translateY(-2px); }
  .download-page__stores img { width: auto; height: 3.5rem; }
  .download-page__visual { width: min(58vw, 46rem); }
  @media (max-width: 62rem) { .download-page__grid { grid-template-columns: 1fr; } .download-page__visual { width: min(95vw, 42rem); justify-self: center; } }
</style>
