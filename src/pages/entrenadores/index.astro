---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrainerCapture from '../../components/TrainerCapture.astro';
import { TRAINERS } from '../../data/site';

const features = [
  {
    id: 'ficha',
    title: 'Cada cliente, en una sola ficha.',
    text: 'Entrenamiento y nutrición se leen juntos: adherencia al plan, evolución del peso, dolor registrado, notas del cliente y cobros, sin saltar entre herramientas.',
    example: 'Antes de ver a Lucía sabes que ha hecho 11 de 12 sesiones, que su adherencia a la dieta está en el 82 % y que su rodilla derecha está por encima del umbral de dolor que fijaste.',
    capture: 'client',
    screen: 'Ficha de cliente',
    caption: 'Resumen con avisos, seguimiento de entrenamiento, nutrición y progreso.',
    alt: 'Ficha de una clienta en TrainFit Trainers con aviso de dolor, notas sin leer y adherencia de entrenamiento y nutrición',
  },
  {
    id: 'planificador',
    title: 'Rutinas por microciclos, serie a serie.',
    text: 'Monta la rutina por microciclos con su objetivo, pauta peso, repeticiones, RIR y descanso de cada serie, compara un microciclo con otro y guarda la estructura como plantilla.',
    example: 'Duplicas el microciclo de acumulación, subes la carga en los básicos para intensificar y reutilizas la rutina con otro cliente desde tu biblioteca.',
    capture: 'planner',
    screen: 'Planificador',
    caption: 'Microciclos con su objetivo, entrenamientos y series pautadas.',
    alt: 'Planificador de TrainFit Trainers con dos microciclos y las series de press banca con peso, repeticiones, RIR y descanso',
  },
  {
    id: 'dietas',
    title: 'Dietas por menús, hechas una vez.',
    text: 'Construye una plantilla con sus menús y comidas y aplícala a cualquier cliente eligiendo solo la fecha de inicio, en vez de teclear cada comida de cada día a mano.',
    example: 'Tienes una base de 1.900 kcal con tres menús a elegir; se la aplicas a un cliente nuevo y él escoge cada día el menú que le encaja.',
    capture: 'diets',
    screen: 'Plantillas de dieta',
    caption: 'Calorías y macros de cada plantilla, menús a elegir y etiquetas como vegana o sin lactosa.',
    alt: 'Biblioteca de plantillas de dieta con calorías, proteína, hidratos y grasas de cada una',
  },
  {
    id: 'check-ins',
    title: 'Check-ins que se comparan solos.',
    text: 'Lee lo que ha contestado tu cliente, compáralo con una respuesta anterior y ciérralo con un comentario que él lee en su check-in. La bandeja Por revisar reúne check-ins, vídeos de técnica y cuestionarios de alta, empezando por lo que más lleva esperando.',
    example: 'La recuperación y el hambre de Lucía han bajado un punto desde la semana anterior. Le dejas un comentario y el check-in sale de tu bandeja.',
    capture: 'checkin',
    screen: 'Revisión de check-in',
    caption: 'Respuesta actual frente a la de referencia, dato a dato.',
    alt: 'Revisión de un check-in semanal que compara recuperación, hambre, hidratación y estrés con la respuesta anterior',
  },
  {
    id: 'avisos',
    title: 'Tu método, vigilando por ti.',
    text: 'Define avisos automatizados con tus propias reglas: cuándo se revisa, qué condición dispara el aviso y hasta dónde llega. Un aviso nunca modifica planes, calorías ni rutinas; como mucho te avisa y te crea tareas.',
    example: 'Si el peso de un cliente cambia menos de un 1 % en 3 semanas, recibes un aviso con la tarea «Revisar kcal y volumen» ya propuesta para aceptarla con un clic.',
    capture: 'automation',
    screen: 'Aviso automatizado',
    caption: 'Condición, acción y nivel de libertad de un aviso de Mi método.',
    alt: 'Editor de un aviso automatizado: si el peso apenas cambia en 3 semanas, crear una tarea de revisión',
  },
];

const more = [
  { title: 'Invitaciones por ámbito', text: 'Invitas a cada cliente por email y eliges si le llevas el entrenamiento, la nutrición o ambos.' },
  { title: 'Cuestionario de alta', text: 'Decides qué le preguntas a un cliente nuevo: objetivos, experiencia, disponibilidad o alimentos que no le gustan, más tus propias preguntas.' },
  { title: 'Vídeos de técnica', text: 'Vinculas tus vídeos de ejecución a ejercicios y revisas los vídeos de técnica que te mandan tus clientes.' },
  { title: 'Cobros', text: 'Registras los pagos de cada cliente y ves lo pendiente y lo vencido desde su ficha.' },
  { title: 'Protocolos', text: 'Empaquetas tu metodología completa y la aplicas de una vez a un cliente nuevo.' },
  { title: 'Puntuaciones de ejercicios', text: 'Defines qué músculos trabaja y qué articulaciones castiga cada ejercicio, según tu criterio.' },
];
---
<BaseLayout title="TrainFit Trainers para entrenadores y nutricionistas" description="TrainFit Trainers: pauta rutinas y dietas, revisa check-ins y sigue la adherencia de cada cliente desde un solo panel." canonicalPath="/entrenadores/">
  <section class="pro-hero" aria-labelledby="pro-title">
    <div class="container pro-hero__grid">
      <div class="pro-hero__copy">
        <p class="eyebrow">{TRAINERS.name} · Para profesionales</p>
        <h1 id="pro-title">Tus clientes, en un solo panel.</h1>
      </div>
      <div class="pro-hero__aside">
        <p class="lede">La herramienta para entrenadores personales y nutricionistas: pautas rutinas y dietas, revisas check-ins y sigues la adherencia de cada cliente sin perseguirlo por WhatsApp ni rehacer el Excel.</p>
        <div class="pro-hero__actions">
          <a class="button button--primary" href={TRAINERS.contactHref}>Solicitar acceso</a>
          <a class="button button--secondary" href="#funciones">Ver cómo funciona</a>
        </div>
      </div>
    </div>
    <figure class="container pro-hero__shot">
      <TrainerCapture name="today" frame="wide" loading="eager" alt="Pantalla Hoy de TrainFit Trainers con avisos de tres clientes, bandeja por revisar y pendientes" />
      <figcaption>
        <b>Hoy</b>
        <span>Cada madrugada se revisan el peso, las medidas, la adherencia y los check-ins de tus clientes. Lo que necesita una decisión tuya aparece aquí, por prioridad y junto a tus pendientes.</span>
      </figcaption>
      <p class="pro-hero__demo">Capturas reales de {TRAINERS.name} con clientes y datos de demostración.</p>
    </figure>
  </section>

  <section class="pro-split section--tight" aria-labelledby="split-title">
    <div class="container">
      <h2 id="split-title" class="subhead">Dos herramientas, un mismo proceso.</h2>
      <div class="pro-split__grid">
        <div class="pro-split__side pro-split__side--pro">
          <p class="metric-label">Para ti</p>
          <h3>{TRAINERS.name}</h3>
          <p>Pautas rutinas, dietas por menús, hábitos y check-ins, y revisas lo que registra cada cliente. Pensada para trabajar desde el ordenador; también se adapta al móvil.</p>
        </div>
        <ol class="pro-split__flow" aria-label="Cómo viaja la información">
          <li><span aria-hidden="true">→</span>Lo que pautas llega a su app</li>
          <li><span aria-hidden="true">←</span>Lo que registra vuelve a ti</li>
        </ol>
        <div class="pro-split__side">
          <p class="metric-label">Para tu cliente</p>
          <h3>App TrainFit</h3>
          <p>Ve lo que le pautas en la pestaña Coach, registra series, comidas, medidas, fotos y dolor, y responde tus check-ins desde el móvil.</p>
          <a class="link-arrow" href="/descargar/">Ver la app de cliente</a>
        </div>
      </div>
    </div>
  </section>

  <section id="funciones" class="pro-features" aria-label={`Funciones de ${TRAINERS.name}`}>
    {features.map((feature, index) => (
      <article id={feature.id} class:list={['pro-feature', { 'pro-feature--alt': index % 2 === 1 }]} aria-labelledby={`${feature.id}-title`}>
        <div class="container">
          <div class="pro-feature__head">
            <div>
              <span class="pro-feature__index">{String(index + 1).padStart(2, '0')}</span>
              <h2 id={`${feature.id}-title`}>{feature.title}</h2>
            </div>
            <div class="pro-feature__text">
              <p>{feature.text}</p>
              <p class="pro-feature__example"><span>Ejemplo</span>{feature.example}</p>
            </div>
          </div>
          <figure class="pro-feature__shot reveal">
            <TrainerCapture name={feature.capture} alt={feature.alt} />
            <figcaption><b>{feature.screen}</b><span>{feature.caption}</span></figcaption>
          </figure>
        </div>
      </article>
    ))}
  </section>

  <section class="pro-more section--tight" aria-labelledby="more-title">
    <div class="container pro-more__grid">
      <h2 id="more-title" class="subhead">Y lo que rodea al día a día.</h2>
      <dl class="pro-more__list">
        {more.map((item) => (
          <div><dt>{item.title}</dt><dd>{item.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="pro-cta section" aria-labelledby="pro-cta-title">
    <div class="container pro-cta__grid">
      <h2 id="pro-cta-title">¿Trabajas con clientes?</h2>
      <div class="pro-cta__action">
        <p>{TRAINERS.name} todavía no tiene alta pública. Escríbenos y te contamos cómo empezar.</p>
        <a class="button button--primary" href={TRAINERS.contactHref}>Solicitar acceso</a>
        <p class="pro-cta__client">¿Eres cliente de un entrenador? <a href="/descargar/">Descarga la app TrainFit</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pro-hero { padding-block: clamp(3.5rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem); overflow: clip; border-bottom: 1px solid var(--color-border); }
  .pro-hero__grid { display: grid; align-items: end; gap: clamp(2rem, 5vw, 5rem); grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  .pro-hero h1 { max-width: 10ch; margin: 0; font-size: clamp(3.2rem, 7vw, 6rem); font-weight: 620; letter-spacing: -.04em; line-height: .92; }
  .pro-hero__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .pro-hero__shot { margin-block: clamp(3rem, 6vw, 5rem) 0; }
  .pro-hero__shot figcaption, .pro-feature__shot figcaption { display: flex; flex-wrap: wrap; gap: .25rem .9rem; margin-top: .9rem; color: var(--color-text-muted); font-size: .82rem; }
  .pro-hero__shot figcaption b, .pro-feature__shot figcaption b { color: var(--color-text); font-weight: 650; }
  .pro-hero__shot figcaption span { max-width: 52rem; }
  .pro-hero__demo { margin: 1.5rem 0 0; color: var(--color-text-muted); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; }

  .pro-split { border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
  .pro-split__grid { display: grid; align-items: start; gap: 2rem; margin-top: 3rem; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
  .pro-split__side { padding-top: 1.5rem; border-top: 1px solid var(--color-border-strong); }
  .pro-split__side--pro { border-top-color: var(--color-accent); }
  .pro-split__side .metric-label { margin: 0; }
  .pro-split__side h3 { margin: .5rem 0 .75rem; font-size: clamp(1.5rem, 2.4vw, 2rem); letter-spacing: -.035em; line-height: 1.05; }
  .pro-split__side p:not(.metric-label) { max-width: 30rem; margin: 0 0 1rem; color: var(--color-text-soft); }
  .pro-split__flow { display: grid; align-content: center; gap: .75rem; margin: 0; padding: 2.5rem 0 0; list-style: none; color: var(--color-text-soft); font-size: .85rem; }
  .pro-split__flow li { display: flex; align-items: center; gap: .6rem; white-space: nowrap; }
  .pro-split__flow span { color: var(--color-accent); font-weight: 700; }

  .pro-feature { padding-block: clamp(4.5rem, 9vw, 8rem); border-bottom: 1px solid var(--color-border); }
  .pro-feature--alt { background: #121212; }
  .pro-feature__head { display: grid; align-items: end; gap: clamp(1.5rem, 5vw, 5rem); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .pro-feature__index { color: var(--color-accent); font-family: var(--font-mono); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .pro-feature h2 { max-width: 14ch; margin: 1rem 0 0; font-size: clamp(2.2rem, 4.4vw, 4rem); font-weight: 620; letter-spacing: -.04em; line-height: .98; }
  .pro-feature__text > p { max-width: 34rem; margin: 0; color: var(--color-text-soft); }
  .pro-feature__example { display: grid; gap: .35rem; margin-top: 1.5rem !important; padding-left: 1rem; border-left: 2px solid var(--color-accent); }
  .pro-feature__example span { color: var(--color-text); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
  .pro-feature__shot { min-width: 0; margin: clamp(2.5rem, 5vw, 4rem) 0 0; }

  .pro-more { border-bottom: 1px solid var(--color-border); }
  .pro-more__grid { display: grid; gap: clamp(2rem, 6vw, 6rem); grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); }
  .pro-more__grid h2 { max-width: 12ch; }
  .pro-more__list { display: grid; margin: 0; border-top: 1px solid var(--color-border-strong); grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; }
  .pro-more__list > div { padding-block: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .pro-more__list dt { font-weight: 650; letter-spacing: -.015em; }
  .pro-more__list dd { margin: .4rem 0 0; color: var(--color-text-soft); font-size: .95rem; }

  .pro-cta { background: var(--color-surface); }
  .pro-cta__grid { display: grid; align-items: end; gap: clamp(2.5rem, 6vw, 5rem); grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }
  .pro-cta h2 { max-width: 13ch; margin: 0; font-size: clamp(2.8rem, 6vw, 5.5rem); font-weight: 620; letter-spacing: -.04em; line-height: .96; }
  .pro-cta__action { display: grid; justify-items: start; gap: 1.5rem; }
  .pro-cta__action p { margin: 0; color: var(--color-text-soft); }
  .pro-cta__client a { color: var(--color-text); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .25em; }

  @media (max-width: 62rem) {
    .pro-hero__grid, .pro-feature__head, .pro-more__grid, .pro-cta__grid { grid-template-columns: minmax(0, 1fr); }
    .pro-split__grid { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .pro-split__flow { grid-auto-flow: column; justify-content: start; gap: 1.5rem; padding: 0; }
    .pro-split__flow span { display: inline-block; transform: rotate(90deg); }
  }
  @media (max-width: 48rem) {
    .pro-hero { padding-top: 2.5rem; }
    .pro-hero h1 { font-size: clamp(2.9rem, 13vw, 4.2rem); }
    .pro-hero__actions .button { flex: 1 1 auto; }
    .pro-split__flow { grid-auto-flow: row; }
    .pro-more__list { grid-template-columns: minmax(0, 1fr); }
    .pro-cta h2 { font-size: clamp(2.5rem, 11vw, 3.6rem); }
  }
</style>
