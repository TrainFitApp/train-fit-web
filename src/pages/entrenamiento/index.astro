---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductPage from '../../components/ProductPage.astro';
const screens = [
  { name: 'workout-summary', alt: 'Resumen con el entrenamiento en curso, el microciclo y el calendario de sesiones' },
  { name: 'mesocycle', alt: 'Planificación de mesociclo con días y ejercicios' },
  { name: 'workout-detail', alt: 'Registro de peso, repeticiones y RIR durante el entrenamiento' },
];
const items = [
  { number: '01', title: 'Construye la estructura', text: 'Organiza rutinas, días y ejercicios antes de empezar la sesión.' },
  { number: '02', title: 'Registra lo importante', text: 'Peso, repeticiones, RIR, descansos y técnicas quedan dentro del entrenamiento.' },
  { number: '03', title: 'Vuelve con contexto', text: 'Consulta sesiones e historial para decidir cómo afrontar la próxima serie.' },
];
---
<BaseLayout title="App de entrenamiento y rutinas" description="Planifica rutinas y registra series, repeticiones, peso y RIR con TrainFit." canonicalPath="/entrenamiento/">
  <ProductPage eyebrow="Entrenamiento" title="Del plan a cada serie." intro="Diseña tu estructura de entrenamiento y conserva el contexto mientras la ejecutas." sectionTitle="Planificación y sesión hablan el mismo idioma." sectionText="TrainFit conecta la vista general de tu rutina con el detalle que necesitas cuando estás entrenando." screens={screens} items={items} theme="training" />
</BaseLayout>
